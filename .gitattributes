# 行尾统一。不加这个文件，Windows 上 git 会把所有文本文件标成
# "LF will be replaced by CRLF"，diff 里全是行尾噪音。
* text=auto eol=lf

# 源码统一 LF
*.go        text eol=lf
*.proto     text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.mod       text eol=lf
*.sum       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
Makefile    text eol=lf
.gitignore  text eol=lf

# PowerShell 脚本留 CRLF：Windows PowerShell 5.1 对纯 LF 的 .ps1 处理不稳
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 二进制
*.exe       binary
*.dll       binary
*.png       binary
*.jpg       binary
*.mp4       binary
